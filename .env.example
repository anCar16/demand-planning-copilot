# Copy this file to .env and fill in your keys. The .env file is never committed.

# Any LiteLLM model string; defaults to gemini/gemini-3.8-flash
LLM_MODEL=gemini/gemini-3.8-flash
# Tried in order if the main model is down (needs that provider's key)
LLM_FALLBACK_MODELS=groq/openai/gpt-oss-120b

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# LangFuse (free cloud tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
